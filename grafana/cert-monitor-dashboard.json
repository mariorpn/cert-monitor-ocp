{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Thanos Querier)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "cert-monitor: Certificados do OpenShift",
  "uid": "cert-monitor-ocp",
  "description": "Expiração e renovação dos certificados x509 encontrados em Secrets e ConfigMaps (cert-monitor).",
  "tags": [
    "certificados",
    "openshift",
    "cert-monitor"
  ],
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "${DS_PROMETHEUS}",
          "value": "${DS_PROMETHEUS}"
        },
        "hide": 0,
        "refresh": 1,
        "options": [],
        "regex": ""
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(cert_not_after_timestamp_seconds, cert_namespace)",
          "refId": "ns"
        },
        "definition": "label_values(cert_not_after_timestamp_seconds, cert_namespace)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "tipo",
        "label": "Tipo",
        "type": "custom",
        "query": "SECRET,CONFIGMAP",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "SECRET",
            "value": "SECRET",
            "selected": false
          },
          {
            "text": "CONFIGMAP",
            "value": "CONFIGMAP",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumo",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Expirados",
      "description": "Entradas (certificado × recurso × posição) já expiradas.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} < time()) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Vencem em ≤ 30 dias",
      "description": "Entradas que expiram nos próximos 30 dias (alerta CertificateExpiringCritical).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} - time()) >= 0 <= 2592000) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Vencem em 31–60 dias",
      "description": "Entradas que expiram entre 31 e 60 dias (alerta CertificateExpiringSoon).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} - time()) > 2592000 <= 5184000) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "✔ Renovados nas últimas 24h",
      "description": "Entradas cuja renovação foi detectada nas últimas 24 horas.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((time() - cert_renewed_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"}) < 86400) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Erros de análise",
      "description": "Certificados únicos que não puderam ser analisados na última varredura.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(cert_monitor_parse_errors) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Última varredura",
      "description": "Tempo desde a última varredura concluída. Atenção acima de 13h; crítico acima de 26h (alerta CertMonitorStale).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(cert_monitor_last_run_timestamp_seconds)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 46800
              },
              {
                "color": "#d03b3b",
                "value": 93600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Certificados",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Certificados",
      "description": "Todos os certificados monitorados, dos que vencem primeiro aos mais distantes. \"✔ Renovado\" (verde) indica renovação detectada nas últimas 24h; a coluna de dias mantém a cor da faixa de vencimento do certificado novo.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "((time() - cert_renewed_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"}) < 86400) * 0 + 4 or (cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} - time() < 0) * 0 + 3 or (cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} - time() <= 2592000) * 0 + 2 or (cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} - time() <= 5184000) * 0 + 1 or cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} * 0",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} - time()) / 86400",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} * 1000",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value #A",
                "Value #B",
                "Value #C",
                "cert_namespace",
                "tipo",
                "name",
                "key",
                "indice",
                "subject_cn"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Situação",
              "Value #B": "Dias restantes",
              "Value #C": "Expira em",
              "cert_namespace": "Namespace",
              "tipo": "Tipo",
              "name": "Nome",
              "key": "Chave",
              "indice": "Posição",
              "subject_cn": "CN"
            },
            "indexByName": {
              "Value #A": 0,
              "Value #B": 1,
              "Value #C": 2,
              "cert_namespace": 3,
              "tipo": 4,
              "name": 5,
              "key": 6,
              "indice": 7,
              "subject_cn": 8
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Nenhum certificado encontrado"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Situação"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "4": {
                        "text": "✔ Renovado",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "3": {
                        "text": "✖ Expirado",
                        "color": "#d03b3b",
                        "index": 1
                      },
                      "2": {
                        "text": "▲ Vence em ≤ 30 dias",
                        "color": "#ec835a",
                        "index": 2
                      },
                      "1": {
                        "text": "▲ Vence em 31–60 dias",
                        "color": "#fab219",
                        "index": 3
                      },
                      "0": {
                        "text": "OK",
                        "color": "transparent",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dias restantes"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#d03b3b",
                      "value": null
                    },
                    {
                      "color": "#ec835a",
                      "value": 0
                    },
                    {
                      "color": "#fab219",
                      "value": 30.0001
                    },
                    {
                      "color": "text",
                      "value": 60.0001
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Expira em"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Posição"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Dias restantes",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Renovações e vencimentos",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Renovados nos últimos 7 dias",
      "description": "Renovações detectadas pelo cert-monitor (data de expiração nova numa chave já monitorada). Verde nas primeiras 24h. A detecção acontece na varredura seguinte à renovação.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 15,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(time() - cert_renewed_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"}) / 3600",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "cert_renewed_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} * 1000",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "cert_not_after_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"} * 1000 and cert_renewed_timestamp_seconds{cert_namespace=~\"$namespace\",tipo=~\"$tipo\"}",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value #D",
                "Value #E",
                "Value #F",
                "cert_namespace",
                "tipo",
                "name",
                "key",
                "subject_cn"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #D": "Há (horas)",
              "Value #E": "Renovação detectada em",
              "Value #F": "Nova expiração",
              "cert_namespace": "Namespace",
              "tipo": "Tipo",
              "name": "Nome",
              "key": "Chave",
              "subject_cn": "CN"
            },
            "indexByName": {
              "Value #D": 0,
              "Value #E": 1,
              "Value #F": 2,
              "cert_namespace": 3,
              "tipo": 4,
              "name": 5,
              "key": 6,
              "subject_cn": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
